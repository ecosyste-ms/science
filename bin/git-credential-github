#!/usr/bin/env ruby

exit unless ARGV.first == "get"

attributes = {}
STDIN.each_line do |line|
  break if line.strip.empty?
  key, value = line.chomp.split("=", 2)
  attributes[key] = value
end

exit unless attributes["protocol"] == "https" &&
  %w[github.com github.com:443].include?(attributes["host"].to_s.downcase)

token = ENV["GITHUB_TOKEN"].to_s
exit if token.empty? || token.match?(/[\r\n]/)

puts "username=x-access-token"
puts "password=#{token}"
