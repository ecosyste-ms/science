      "schedule": "*/30 * * * *"
    },
    {
      "command": "bundle exec rake projects:import",
      "schedule": "0 0 * * *"
    },
    {
      "command": "bundle exec rake projects:import_metadata_repositories",
      "schedule": "0 1 * * *"
    },
    {
      "command": "bundle exec rake projects:sync",
      "schedule": "*/10 * * * *"
    },
    {
