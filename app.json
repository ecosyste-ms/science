{
  "cron": [
    {
      "command": "bundle exec rake projects:import_joss",
      "schedule": "*/30 * * * *"
    },
    {
      "command": "bundle exec rake projects:import",
      "schedule": "0 0 * * *"
    },
    {
      "command": "bundle exec rake projects:sync",
      "schedule": "*/10 * * * *"
    },
    {
      "command": "bundle exec rake projects:fetch_brief LIMIT=50",
      "schedule": "*/10 * * * *"
    },
    {
      "command": "bundle exec rake homepage:refresh",
      "schedule": "5 * * * *"
    },
    {
      "command": "bundle exec rake joss_vocabulary:rebuild",
      "schedule": "0 3 * * 0"
    },
    {
      "command": "bundle exec rake research_organizations:sync",
      "schedule": "0 4 * * 1"
    }
  ]
}
