<% @meta_title = @field.name %>
<% @meta_description = "Scientific software projects classified in #{@field.name}" %>

<div class="container-md">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Fields", fields_path %></li>
      <li class="breadcrumb-item">
        <%= link_to @field.domain_display_name, open_alex_domain_path(@domain_slug) %>
      </li>
      <li class="breadcrumb-item active" aria-current="page"><%= @field.name %></li>
    </ol>
  </nav>

  <h1><%= @field.name %></h1>
  <p class="lead text-muted"><%= @field.domain_display_name %></p>

  <div class="row mb-4">
    <div class="col-md-8 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">OpenAlex Classification</h5>
          <p>
            <strong>Field ID:</strong> <%= @field.openalex_id %><br>
            <strong>Projects:</strong> <%= @stats[:total_projects] %><br>
            <strong>Average classifier score:</strong>
            <%= @stats[:average_score] ? number_with_precision(@stats[:average_score], precision: 3) : "N/A" %><br>
            <strong>Topics:</strong> <%= @topic_count %>
          </p>

          <% if @subfields.any? %>
            <h6>Subfields</h6>
            <% @subfields.each do |_subfield_id, subfield_name| %>
              <span class="badge bg-light text-dark me-1 mb-1">
                <%= subfield_name %>
              </span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Related Fields</h5>
          <% if @related_fields.any? %>
            <ul class="list-unstyled mb-0">
              <% @related_fields.each do |field| %>
                <li class="mb-2">
                  <%= link_to field.name, field_path(field) %>
                  <small class="text-muted">
                    (<%= @related_field_counts.fetch(field.id, 0) %> projects)
                  </small>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted mb-0">No other fields in this domain.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @top_keywords.any? %>
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">Common Project Keywords</h5>
        <% @top_keywords.each do |keyword, count| %>
          <span class="badge bg-light text-dark me-1 mb-1">
            <%= keyword %> <span class="text-muted">(<%= count %>)</span>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>

  <h3>
    Projects in <%= @field.name %>
    <span class="text-muted">(<%= @stats[:total_projects] %>)</span>
  </h3>

  <% if @project_fields.any? %>
    <% @project_fields.each do |project_field| %>
      <% project = project_field.project %>
      <div class="card mb-3">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <h5 class="card-title">
                <%= link_to project.to_s, project_path(project) %>
                <span class="badge bg-info ms-2">
                  score <%= number_with_precision(project_field.confidence_score, precision: 3) %>
                </span>
              </h5>

              <% if project.description.present? %>
                <p class="card-text text-muted"><%= project.description %></p>
              <% end %>

              <% matched_terms = Array(project_field.match_signals&.fetch("matched_terms", nil)) %>
              <% if matched_terms.any? %>
                <div class="mb-2">
                  <% matched_terms.each do |term| %>
                    <span class="badge bg-light text-dark me-1"><%= term.humanize %></span>
                  <% end %>
                </div>
              <% end %>

              <% other_fields = project.open_alex_fields_with_scores.reject { |field, _| field == @field } %>
              <% if other_fields.any? %>
                <small class="text-muted">
                  Also ranked in:
                  <% other_fields.each_with_index do |(field, _), index| %>
                    <%= link_to field.name, field_path(field) %><%= "," unless index == other_fields.size - 1 %>
                  <% end %>
                </small>
              <% end %>
            </div>

            <% if project.science_score.present? %>
              <div class="text-end ms-3">
                <small class="text-muted">Science Score</small><br>
                <span class="badge bg-primary"><%= project.science_score.round %>%</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%== pagy_bootstrap_nav(@pagy) %>
  <% else %>
    <div class="alert alert-info">
      No projects have been classified in this field yet.
    </div>
  <% end %>
</div>
