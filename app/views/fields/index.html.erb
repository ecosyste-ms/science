<% @meta_title = "Scientific Fields" %>

<div class="container-md">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h1>Scientific Fields</h1>
      <p class="text-muted">
        Scientific software projects ranked against the OpenAlex topic hierarchy.
      </p>
    </div>
    <%= link_to "View All Projects", projects_path, class: "btn btn-outline-primary" %>
  </div>

  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <h3 class="text-primary"><%= number_with_delimiter @fields.count %></h3>
          <p class="text-muted mb-0">OpenAlex Fields</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <h3 class="text-success"><%= number_with_delimiter @classified_projects_count %></h3>
          <p class="text-muted mb-0">Classified Projects</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <h3 class="text-info"><%= @multi_field_projects_count %></h3>
          <p class="text-muted mb-0">Multi-field Projects</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <h3 class="text-warning"><%= number_with_delimiter @active_topic_count %></h3>
          <p class="text-muted mb-0">Active Topics</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <% @domains.each do |domain| %>
      <div class="col-lg-6 mb-4">
        <div class="card h-100">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
              <%= link_to domain[:name], open_alex_domain_path(domain[:slug]), class: "text-white text-decoration-none" %>
            </h5>
          </div>
          <div class="card-body">
            <% domain[:fields].each do |field| %>
              <div class="d-flex justify-content-between align-items-start mb-3 pb-2 border-bottom">
                <h6 class="mb-0">
                  <%= link_to field.name, field_path(field), class: "text-decoration-none" %>
                </h6>
                <span class="badge bg-light text-dark ms-2">
                  <%= @field_stats.fetch(field.id, 0) %> projects
                </span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
