<div class="card mb-3 release d-flex" id="release_<%= release.id %>">
  <div class="card-body pb-1">
    <div class="d-flex">
      
      <div class="flex-grow-1 ms-3 text-break">
        <h5 class='card-title'>
          <%= link_to release.project.to_s, project_url(release.project) %> - <%= link_to release.title, project_release_path(release.project, release) %>
        </h5>

        <% if release.body.present? %>
          <div class="card-text"><%== render_markdown release.body %></div>
        <% end %>
      
        <p class="card-subtitle mb-2 text-muted"><small>
          <% if release.project.category %>
            <%= release.project.category %> - <%= release.project.sub_category %>
          <% end %>
          <% if release.project.language%>
            - <%= release.project.language %>
          <% end %>
          <br/>
          <% if release.published_at.present? %>
            Released <%= time_ago_in_words(release.published_at) %> ago
          <% elsif release.tag_published_at.present? %>
            Tag dated <%= time_ago_in_words(release.tag_published_at) %> ago
          <% else %>
            Date unavailable
          <% end %>
          <% if release.author.present? %>
            by <%= release.author %>
          <% end %>
          <br />
        </small></p>
      </div>
      <div class="flex-shrink-0">
        <img src="<%= release.project.avatar_url %>" class="rounded" height="40" width="40" alt="" loading="lazy">
      </div>  
    </div>
  </div>
</div>
