<% @meta_title = "Discovery review" %>
<div class="container-md">
  <p><%= link_to "Discovery queue", jev_discoveries_path(run_id: @discovery.jev_run_id) %></p>
  <h1 class="h3"><%= link_to @discovery.repository_url, @discovery.repository_url, rel: "noopener noreferrer" %></h1>
  <p><%= @discovery.classification.humanize %> · <%= @discovery.status.humanize %> · <%= @discovery.sample_group %></p>
  <p>Research probability: <%= @discovery.strict_probability&.round(3) || "Pending" %>. Implementation probability: <%= @discovery.implementation_probability&.round(3) || "Not enriched" %>.</p>
  <% if @discovery.project %><p>Existing project: <%= link_to @discovery.project.name.presence || @discovery.project.url, project_path(@discovery.project) %>. Science Score: <%= @discovery.project.science_score %>.</p><% end %>
  <% if @discovery.control? %><p>Random control from the <%= @discovery.screen_band %> screen band. Enrichment selection probability: <%= @discovery.control_probability %>.</p><% end %>
  <% [@discovery.last_error, @discovery.enrichment_error].compact.each do |error| %><p class="alert alert-warning"><%= error %></p><% end %>
  <% if @discovery.evidence.key?("skipped_large_files") %>
    <div class="card card-body mb-4">
      <h2 class="h5">Evidence coverage</h2>
      <p><%= @discovery.evidence["skipped_large_files"] %> large files omitted from the checkout. Tracked filenames can still appear in the model input; Brief counts cover downloaded content.</p>
      <% if @discovery.evidence.key?("skipped_file_paths") %>
        <% if @discovery.evidence["skipped_file_types"].present? %><p>Omitted file types: <%= @discovery.evidence["skipped_file_types"].map { |type, count| "#{type}: #{count}" }.join(" · ") %>.</p><% end %>
        <% if @discovery.evidence["skipped_file_paths"].any? %><ul><% @discovery.evidence["skipped_file_paths"].each do |path| %><li><code><%= path %></code></li><% end %></ul><% end %>
        <% if @discovery.evidence["skipped_file_paths_truncated"] %><p>Only the first 40 omitted filenames are shown.</p><% end %>
      <% elsif @discovery.evidence["skipped_large_files"].to_i.positive? %>
        <p>Omitted filenames were not recorded for this collection.</p>
      <% end %>
    </div>
  <% end %>
  <% if (identity = @discovery.evidence["repository_identity"]) %>
    <div class="card card-body mb-4">
      <h2 class="h5">Repository identity</h2>
      <p><%= identity.fetch("status").humanize %>. Checked <%= identity["checked_at"] %>.</p>
      <p>README and fork references suggest related repositories. They do not establish that the implementations are identical.</p>
      <% identity.fetch("matches", []).each do |match| %>
        <p><%= link_to match.fetch("project_url"), project_path(match.fetch("project_id")) %>: Science Score <%= match["science_score"] %>, <%= match.fetch("relation").humanize.downcase %><%= " (confirmed repository identity)" if match["confirmed"] %>.</p>
      <% end %>
      <% identity.fetch("related_candidates", []).each do |candidate| %><p>Related candidate: <%= link_to candidate.fetch("url"), jev_discovery_path(candidate.fetch("id")) %>.</p><% end %>
      <% if identity["copy_statement"] %><p>The README contains an explicit copy or move statement. Review its context before counting a distinct discovery.</p><% end %>
    </div>
  <% end %>
  <%= form_with model: @discovery, local: true, class: "card card-body mb-4" do |form| %>
    <h2 class="h5">Review</h2>
    <p>This records your judgement only. It does not change Science Score or catalogue inclusion.</p>
    <% if @discovery.errors.any? %><p class="text-danger"><%= @discovery.errors.full_messages.join(". ") %></p><% end %>
    <%= form.label :review_state, "Judgement", class: "form-label" %>
    <%= form.select :review_state, [["Unreviewed", "unreviewed"], ["Supported research software", "research"], ["Uncertain", "uncertain"], ["Not research software", "negative"]], {}, class: "form-select mb-3" %>
    <p>Record scientific purpose, implementation evidence and catalogue value separately. A scientific implementation may already be represented or have an unresolved identity.</p>
    <% { review_purpose: ["Scientific purpose", Jev::Discovery::REVIEW_PURPOSES], review_implementation: ["Implementation evidence", Jev::Discovery::REVIEW_IMPLEMENTATIONS], review_catalogue_value: ["Catalogue value", Jev::Discovery::REVIEW_CATALOGUE_VALUES] }.each do |key, (label, values)| %>
      <%= form.label key, label, class: "form-label" %>
      <%= form.select key, values.map { |value, text| [text, value] }, { include_blank: "Not assessed" }, class: "form-select mb-3" %>
    <% end %>
    <%= form.label :review_notes, "Evidence and limitations", class: "form-label" %>
    <%= form.text_area :review_notes, rows: 5, maxlength: 4000, class: "form-control mb-3" %>
    <%= form.submit "Save review", class: "btn btn-primary" %>
  <% end %>
  <% [@discovery.screen_request, @discovery.enrich_request].compact.each do |request| %>
    <h2 class="h5"><%= request.stage.humanize %> evaluation</h2>
    <p>Model: <%= request.model %>. Question fingerprints: <%= request.question_versions.values.join(", ") %>. Evaluated: <%= request.completed_at %>. Input tokens: <%= request.input_tokens %>.</p>
  <% end %>
  <h2 class="h5">Sampling and provenance</h2>
  <p><%= @discovery.source %> · <%= @discovery.sampling_method %></p>
  <pre><%= JSON.pretty_generate(@discovery.source_metadata) %></pre>
  <h2 class="h5">Evidence supplied for classification</h2>
  <pre><%= JSON.pretty_generate(@discovery.evidence) %></pre>
</div>
