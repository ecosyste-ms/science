<% @meta_title = "#{@project}" %>
<% @meta_description = @project.description %>

<div class="container-md">
  <div class="mb-4">
    <h1 class="mb-3"><%= @project.to_s %></h1>

    <% if @project.description.present? %>
      <p class="lead text-muted mb-3"><%= @project.description %></p>
    <% end %>

    <% if @project.url.present? %>
      <p><%= link_to @project.url, @project.url, class: "text-decoration-none" %></p>
    <% end %>
  </div>

  <% if @project.last_synced_at %>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4 text-muted">
      <small>
        Last synced: <%= distance_of_time_in_words_to_now @project.last_synced_at %> ago
      </small>
      <span aria-hidden="true">&middot;</span>
      <%= link_to "JSON representation",
        api_v1_project_path(@project),
        class: "small text-decoration-none" %>
      <% if @project.citation_file.present? %>
        <span aria-hidden="true">&middot;</span>
        <div class="btn-group" role="group">
          <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
            Export Citation
          </button>
          <ul class="dropdown-menu">
            <li>
              <%= link_to "BibTeX",
                export_project_path(@project, format: "bibtex"),
                class: "dropdown-item" %>
            </li>
            <li>
              <%= link_to "APA Style",
                export_project_path(@project, format: "apalike"),
                class: "dropdown-item" %>
            </li>
          </ul>
        </div>
      <% end %>
    </div>

    <ul class="nav nav-tabs flex-nowrap overflow-auto mb-4"
      id="project-tabs"
      role="tablist">
      <% [
        ["overview", "Overview"],
        ["repository", "Repository"],
        ["research", "Research"],
        ["activity", "Activity"],
        ["packages", "Packages"],
      ].each_with_index do |(id, label), index| %>
        <li class="nav-item" role="presentation">
          <button class="nav-link text-nowrap <%= "active" if index.zero? %>"
            id="project-<%= id %>-tab"
            data-bs-toggle="tab"
            data-bs-target="#project-<%= id %>"
            type="button"
            role="tab"
            aria-controls="project-<%= id %>"
            aria-selected="<%= index.zero? %>">
            <%= label %>
          </button>
        </li>
      <% end %>
    </ul>

    <div class="tab-content" id="project-tab-content">
      <div class="tab-pane fade show active"
        id="project-overview"
        role="tabpanel"
        aria-labelledby="project-overview-tab"
        tabindex="0">
        <%= render "overview" %>
      </div>
      <div class="tab-pane fade"
        id="project-repository"
        role="tabpanel"
        aria-labelledby="project-repository-tab"
        tabindex="0">
        <%= render "section_tabs",
          section: "repository",
          empty_message: "No repository metadata is available.",
          tabs: [
            {
              id: "details",
              label: "Details",
              partial: "repository",
              visible: @project.repository.present?,
            },
            {
              id: "readme",
              label: "README",
              partial: "readme",
              visible: @project.readme.present?,
            },
            {
              id: "owner",
              label: "Owner",
              partial: "owner",
              visible: @project.read_attribute(:owner).present?,
            },
          ] %>
      </div>
      <div class="tab-pane fade"
        id="project-research"
        role="tabpanel"
        aria-labelledby="project-research-tab"
        tabindex="0">
        <%= render "section_tabs",
          section: "research",
          empty_message: "No research metadata is available.",
          tabs: [
            {
              id: "joss",
              label: "JOSS",
              partial: "joss",
              visible: @project.joss_metadata.present?,
            },
            {
              id: "citation",
              label: "Citation",
              partial: "citation",
              visible: @project.citation_file.present?,
            },
            {
              id: "codemeta",
              label: "CodeMeta",
              partial: "codemeta",
              visible: @project.codemeta.present?,
            },
            {
              id: "zenodo",
              label: "Zenodo",
              partial: "zenodo",
              visible: @project.zenodo.present?,
            },
            {
              id: "papers",
              label: "Papers",
              partial: "mentions",
              visible: @project.mentions.any?,
            },
          ] %>
      </div>
      <div class="tab-pane fade"
        id="project-activity"
        role="tabpanel"
        aria-labelledby="project-activity-tab"
        tabindex="0">
        <%= render "section_tabs",
          section: "activity",
          empty_message: "No repository activity has been collected.",
          tabs: [
            {
              id: "committers",
              label: "Committers",
              partial: "committers",
              visible: @project.commits&.[]("last_synced_at").present?,
            },
            {
              id: "issues",
              label: "Issues and pull requests",
              partial: "issues",
              visible: @project.issue_stats&.[]("last_synced_at").present?,
            },
            {
              id: "events",
              label: "Events",
              partial: "events",
              visible: @project.events.present?,
            },
          ] %>
      </div>
      <div class="tab-pane fade"
        id="project-packages"
        role="tabpanel"
        aria-labelledby="project-packages-tab"
        tabindex="0">
        <%= render "section_tabs",
          section: "packages",
          empty_message: "No package or dependency data is available.",
          tabs: [
            {
              id: "published",
              label: "Published packages",
              partial: "packages",
              locals: { project: @project },
              visible: @project.packages.present?,
            },
            {
              id: "dependencies",
              label: "Dependencies",
              partial: "dependencies",
              visible: @project.dependencies.present?,
            },
          ] %>
      </div>
    </div>
  <% else %>
    <p>
      This project has not been synced yet. Check back in a few minutes.
      <meta http-equiv="refresh" content="10">
    </p>
  <% end %>
</div>
