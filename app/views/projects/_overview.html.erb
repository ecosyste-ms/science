<% if @project.science_score.present? && @project.science_score.positive? %>
  <div class="card mb-4 border-0 shadow-sm">
    <div class="card-header bg-white border-bottom">
      <h2 class="h4 mb-0">
        Science Score:
        <span class="text-primary">
          <%= number_with_precision(@project.science_score, precision: 1) %>%
        </span>
      </h2>
    </div>
    <div class="card-body">
      <% breakdown = @project.science_score_breakdown %>
      <p class="text-muted mb-3">
        This score indicates how likely this project is to be science-related based on various indicators:
      </p>

      <% if breakdown.present? && breakdown[:breakdown].present? %>
        <ul class="list-group list-group-flush">
          <% breakdown[:breakdown].each_value do |value| %>
            <li class="list-group-item border-0 px-0">
              <div class="d-flex align-items-start">
                <span class="me-2 fs-5 <%= value[:present] ? "text-success" : "text-muted" %>">
                  <%= value[:present] ? "✓" : "○" %>
                </span>
                <div>
                  <strong><%= value[:description] %></strong>
                  <% if value[:details].present? %>
                    <br>
                    <small class="text-muted"><%= value[:details] %></small>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted"><em>Score breakdown is being calculated...</em></p>
      <% end %>
    </div>
  </div>
<% end %>

<% if @project.keywords.any? %>
  <section class="mb-4" data-role="project-keywords">
    <h2 class="h4 mb-3">Keywords</h2>
    <div>
      <% @project.keywords.each do |keyword| %>
        <span class="badge rounded-pill bg-light text-dark me-2 mb-2">
          <%= keyword %>
        </span>
      <% end %>
    </div>
  </section>
<% end %>

<% if @project.keywords_from_contributors.any? %>
  <section class="mb-4" data-role="contributor-keywords">
    <h2 class="h4 mb-3">Keywords from Contributors</h2>
    <div>
      <% @project.keywords_from_contributors.each do |keyword| %>
        <span class="badge rounded-pill bg-light text-dark me-2 mb-2">
          <%= keyword %>
        </span>
      <% end %>
    </div>
  </section>
<% end %>

<% if @project.open_alex_fields_with_scores.any? %>
  <section class="mb-4" data-role="scientific-fields">
    <h2 class="h4 mb-3">Scientific Fields</h2>
    <% @project.open_alex_fields_with_scores.each do |field, score| %>
      <div class="mb-2">
        <span class="badge rounded-pill bg-primary me-2">
          <%= link_to field.name,
            field_path(field),
            class: "text-white text-decoration-none" %>
        </span>
        <small class="text-muted">
          <%= field.domain_display_name %>, classifier score
          <%= number_with_precision(score, precision: 3) %>
        </small>
      </div>
    <% end %>
  </section>
<% end %>
