<% data = @project.swhids %>

<section class="mb-4">
  <h2 class="mb-3">SWHIDs</h2>
  <p class="text-muted">
    Software Hash Identifiers identify a specific revision or directory of source code.
  </p>

  <% if data["status"] == "error" %>
    <p class="alert alert-warning">SWHID calculation did not complete.</p>
  <% end %>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <dl class="row mb-0">
        <% if (coverage = data["origin_archive"]) %>
          <dt class="col-md-3 mb-2">Repository coverage</dt>
          <dd class="col-md-9 mb-3" data-role="swhid-origin-archive">
            <%= { "archived" => "Archived snapshot found", "not_found" => "No archived snapshot found at the checked URLs" }.fetch(coverage["status"], "Coverage unknown") %>
            <% if coverage["checked_at"].present? %>
              <div class="small text-muted">Checked <%= time_tag Time.iso8601(coverage["checked_at"]).utc, format: "%B %d, %Y at %H:%M UTC" %></div>
            <% end %>
          </dd>
        <% end %>

        <% if (baseline = data.dig("archival", "repository_before_request")) %>
          <dt class="col-md-3 mb-2">Archival request</dt>
          <dd class="col-md-9 mb-3" data-role="swhid-request-classification">
            <%= { "missing_versions" => "Missing version of an archived repository", "missing_repository" => "No repository snapshot found before submission" }.fetch(baseline["classification"], "Prior repository coverage unknown") %>
            <% if baseline["basis"] == "visit_history" %>
              <div class="small text-muted">Inferred from historical visit dates</div>
            <% end %>
          </dd>
        <% end %>

        <% [["revision", "Revision"], ["directory", "Directory"]].each do |type, label| %>
          <dt class="col-md-3 mb-2"><%= label %></dt>
          <dd class="col-md-9 mb-3" data-role="swhid-<%= type %>">
            <% if data.dig(type, "status") == "success" && data.dig(type, "swhid").present? %>
              <% identifier = data.dig(type, "swhid") %>
              <code class="text-break user-select-all"><%= link_to identifier, "https://archive.softwareheritage.org/browse/#{type}/#{identifier.split(':').last}/" %></code>
              <% archive = data.dig(type, "archive") || {} %>
              <div class="small mt-1" data-role="swhid-<%= type %>-archive">
                <% if archive["status"] == "archived" %>
                  <span class="badge bg-success">Archived</span>
                <% elsif archive["status"] == "not_found" %>
                  <span class="badge bg-light text-dark">Not found</span>
                <% elsif archive["status"] == "error" %>
                  <span class="badge bg-warning text-dark">Check failed</span>
                <% else %>
                  <span class="badge bg-light text-dark">Not checked</span>
                <% end %>
                <% if archive["checked_at"].present? %>
                  <span class="text-muted">
                    Checked <%= time_tag Time.iso8601(archive["checked_at"]).utc, format: "%B %d, %Y at %H:%M UTC" %>
                  </span>
                <% elsif archive["attempted_at"].present? %>
                  <span class="text-muted">
                    Last attempted <%= time_tag Time.iso8601(archive["attempted_at"]).utc, format: "%B %d, %Y at %H:%M UTC" %>
                  </span>
                <% end %>
              </div>
            <% else %>
              <span class="text-muted">Unavailable</span>
            <% end %>
          </dd>
        <% end %>

        <% if data["commit"].present? %>
          <dt class="col-md-3 mb-2">Commit</dt>
          <dd class="col-md-9 mb-3">
            <code class="text-break user-select-all"><%= data["commit"] %></code>
          </dd>
        <% end %>

        <% if data["origin"].present? %>
          <dt class="col-md-3 mb-2">Source</dt>
          <dd class="col-md-9 mb-3 text-break"><%= data["origin"] %></dd>
        <% end %>

        <% if data["attempted_at"].present? %>
          <dt class="col-md-3 mb-2"><%= data["status"] == "success" ? "Calculated" : "Last attempted" %></dt>
          <dd class="col-md-9 mb-0">
            <%= time_tag Time.iso8601(data["attempted_at"]).utc, format: "%B %d, %Y at %H:%M UTC" %>
          </dd>
        <% end %>
      </dl>
    </div>
  </div>
</section>
