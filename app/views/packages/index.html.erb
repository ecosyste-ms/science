<% @meta_title = "Scientific Packages" %>
<% @meta_description = "Packages used directly by scientific software projects." %>

<div class="container-md">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h1>Scientific Packages</h1>
      <p class="text-muted">
        Packages published by scientific projects, ranked by the Science Score of their repository.
      </p>
    </div>
    <%= link_to "View All Projects", projects_path, class: "btn btn-outline-primary" %>
  </div>


  <h2 class="h4 mb-3">
    <%= number_with_delimiter @pagy.count %>
    <%= "package".pluralize(@pagy.count) %>
  </h2>

  <% if @packages.load.any? %>
    <% @packages.each do |package| %>
      <div class="card mb-3" data-package-id="<%= package.id %>">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start gap-3">
            <div class="flex-grow-1">
              <h3 class="h5 card-title mb-2">
                <% if package.published_by_project %>
                  <%= link_to package.name, project_path(package.published_by_project) %>
                <% elsif package.repository_url.present? %>
                  <%= link_to package.name,
                    package.repository_url,
                    target: "_blank",
                    rel: "noopener" %>
                <% else %>
                  <%= package.name %>
                <% end %>
              </h3>
              <div class="mb-2">
                <span class="badge bg-light text-dark"><%= package.package_registry.ecosystem %></span>
                <span class="badge bg-light text-dark"><%= package.package_registry.name %></span>
              </div>

              <% if package.metadata["description"].present? %>
                <p class="card-text text-muted"><%= package.metadata["description"] %></p>
              <% end %>

              <% if package.purl.present? %>
                <p class="mb-2"><code><%= package.purl %></code></p>
              <% end %>

              <% if package.published_by_project %>
                <p class="mb-0 text-muted">
                  Published by
                  <%= link_to package.published_by_project.to_s,
                    project_path(package.published_by_project) %>
                </p>
              <% end %>
              <% paper_links = package.package_papers.to_a + (package.published_by_project&.project_papers&.to_a || []) %>
              <% if paper_links.any? %>
                <div class="mt-3">
                  <h4 class="h6">Related papers</h4>
                  <%= render "papers/relationships", links: paper_links %>
                </div>
              <% end %>
            </div>

          </div>
        </div>
      </div>
    <% end %>

    <%== pagy_bootstrap_nav(@pagy) if @pagy.pages > 1 %>
  <% else %>
    <div class="alert alert-info">
      No packages found.
    </div>
  <% end %>
</div>
